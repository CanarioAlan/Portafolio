<h1 class={'titulo-presentacion text-4xl font-bold '}>
  <span id="saludo"></span>, Soy
  <span class="palabra text-secundario NombreCompleto">Alan Canario</span>.
</h1>

<script >
  import { animate, scrambleText } from 'animejs';
  const saludoE = document.getElementById('saludo');
  const hora = new Date().getHours();
  let saludo = '';
  if (hora >= 6 && hora < 12) {
    saludo = 'Buenos días';
  } else if (hora >= 12 && hora < 18) {
    saludo = 'Buenas tardes';
  } else {
    saludo = 'Buenas noches';
  }
  saludoE.textContent = saludo;
  animate('.NombreCompleto', {
    innerHTML: scrambleText(),
    loop: true,
    loopDelay: 2500,
  });
</script>
