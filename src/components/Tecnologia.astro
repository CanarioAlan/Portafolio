---
const tecnologias = [
    {nombre: "HTML5", icono: "html5", categoria: "frontend"},
    {nombre: "CSS", icono: "css3", categoria: "frontend"},
    {nombre: "Tailwind CSS", icono: "tailwindcss", categoria: "frontend"},
    {nombre: "SASS", icono: "sass", categoria: "frontend"},
    {nombre: "JavaScript", icono: "javascript", categoria: "frontend"},
    {nombre: "Astro", icono: "astro", categoria: "frontend"},
    {nombre: "PHP", icono: "php", categoria: "backend"},
    {nombre: "MYSQL", icono: "mysql", categoria: "backend"},
    // {nombre: "Node.JS", icono: "nodejs"}, 
    // {nombre: "React", icono: "react"}, 
    // {nombre: "TypeScript", icono: "typescript"}, 
    // {nombre: "Laravel", icono: "laravel"},
]
const frontend = tecnologias.filter(tech => tech.categoria === "frontend");
const backend = tecnologias.filter(tech => tech.categoria === "backend");
---
<section id="tecnologias" class="fade-on-scroll opacity-0 translate-y-8 transition-all duration-1000">
    <h2 class="text-2xl font-titulo my-8 font-bold tracking-wider">
      Mis <span class="text-secundario">tecnologias</span>
    </h2>
    <div class="flex flex-col gap-8">
      <h3 class="text-xl font-semibold mb-4 text-left">Frontend</h3>
      <div class="grid grid-cols-3 md:grid-cols-3 lg:grid-cols-6 gap-2 transition-colors  ">
        {frontend.map(tech => (
          <div class="flex flex-col items-center gap-2 p-2 bg-secundario/5 hover:bg-primario/40 transition-colors rounded-lg hover:animate-boton backdrop-blur-sm">
              <i class={`devicon-${tech.icono}-plain colored text-4xl`}></i>
              <span class="text-text">{tech.nombre}</span>
            </div>
          ))}
      </div>
      <div>
        <h3 class="text-xl font-semibold mb-4 text-left">Backend</h3>
        <div class="grid grid-cols-3 md:grid-cols-3 lg:grid-cols-6 gap-2 transition-colors  ">
          {backend.map(tech => (
            <div class="flex flex-col items-center gap-2 p-2 bg-secundario/5 hover:bg-primario/40 transition-colors rounded-lg hover:animate-boton backdrop-blur-sm">
              <i class={`devicon-${tech.icono}-plain colored text-4xl`}></i>
              <span class="text-text">{tech.nombre}</span>
            </div>
          ))}
        </div>
    </div>
</section>