---
let sending = false;
let success = false;
---

<section
  class="w-full mb-7 fade-on-scroll opacity-0 translate-y-8 transition-all duration-1000"
  id="contacto"
>
  <h2
    class="text-3xl my-8 font-titulo text-secundario font-bold tracking-wider"
  >
    Contacto
  </h2>

  <div
    class="max-w-xl mx-auto bg-base/10 backdrop-blur-sm rounded-2xl border border-secundario/10 p-8"
  >
    <p
      id="obligatorio"
      class="text-texto text-sm font-secundario mb-6 tracking-wide"
    >
      Todos los campos son obligatorios
    </p>

    <form
      id="contact-form"
      class="flex flex-col gap-5 text-start"
    >
      <div class="flex flex-col">
        <label
          for="nombre"
          class="text-sm font-secundario text-texto uppercase tracking-wider mb-2"
        >
          Nombre
        </label>
        <input
          type="text"
          name="nombre"
          id="nombre"
          required
          placeholder="Ingrese su nombre"
          class="py-3 px-4 bg-base/20 border border-secundario/10 text-blue-50 placeholder:text-texto/50 rounded-lg focus:border-secundario/60 focus:outline-none focus:ring-1 focus:ring-secundario/30 hover:border-secundario/30 transition-colors duration-300"
        />
      </div>

      <div class="flex flex-col">
        <label
          for="email"
          class="text-sm font-secundario text-texto uppercase tracking-wider mb-2"
        >
          E-mail
        </label>
        <input
          type="email"
          name="email"
          id="email"
          placeholder="Ingrese su email"
          required
          class="py-3 px-4 bg-base/20 border border-secundario/10 text-blue-50 placeholder:text-texto/50 rounded-lg focus:border-secundario/60 focus:outline-none focus:ring-1 focus:ring-secundario/30 hover:border-secundario/30 transition-colors duration-300"
        />
      </div>

      <div class="flex flex-col">
        <label
          for="msj"
          class="text-sm font-secundario text-texto uppercase tracking-wider mb-2"
        >
          Mensaje
        </label>
        <textarea
          name="msj"
          id="mensaje"
          required
          placeholder="Ingrese su mensaje, ej: Hola, me gustaria saber mas sobre su trabajo."
          class="h-32 py-3 px-4 bg-base/20 border border-secundario/10 text-blue-50 placeholder:text-texto/50 rounded-lg focus:border-secundario/60 focus:outline-none focus:ring-1 focus:ring-secundario/30 hover:border-secundario/30 transition-colors duration-300 resize-none"
        ></textarea>
      </div>

      <input
        type="submit"
        value="Enviar mensaje"
        id="enviar"
        class="w-full mt-2 py-3 text-lg font-semibold bg-secundario text-base rounded-lg cursor-pointer hover:bg-secundario/90 hover:shadow-lg hover:shadow-secundario/20 transition-all duration-300"
      />

      <div
        id="feedback-exito"
        class="hidden items-center gap-3 bg-green-500/10 border border-green-500/20 rounded-lg p-4 mt-2"
      >
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="#22c55e" stroke-width="1.5" opacity="0.3" />
          <path
            d="M8 12.5l2.5 2.5 5.5-5.5"
            stroke="#22c55e"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-dasharray="24"
            stroke-dashoffset="24"
            class="animate-check"
          />
        </svg>
        <span class="text-green-400 text-sm font-secundario">
          ¡Mensaje enviado con éxito!
        </span>
      </div>

      <div
        id="feedback-error"
        class="hidden items-center gap-3 bg-red-500/10 border border-red-500/20 rounded-lg p-4 mt-2"
      >
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="#ef4444" stroke-width="1.5" opacity="0.3" />
          <path
            d="M15 9l-6 6M9 9l6 6"
            stroke="#ef4444"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-dasharray="20"
            stroke-dashoffset="20"
            class="animate-cross"
          />
        </svg>
        <span id="feedback-error-text" class="text-red-400 text-sm font-secundario">
          Error al enviar el mensaje
        </span>
      </div>
    </form>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("contact-form");
    const inputs = form?.querySelectorAll("input, textarea");
    const btnEnviar = document.getElementById("enviar") as HTMLInputElement;
    const obligatorio = document.getElementById("obligatorio");
    const feedbackExito = document.getElementById("feedback-exito");
    const feedbackError = document.getElementById("feedback-error");
    const feedbackErrorText = document.getElementById("feedback-error-text");

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const mostrarFeedback = (
      elemento: HTMLElement | null,
      duracion: number = 4000
    ) => {
      if (!elemento) return;
      elemento.classList.remove("hidden");
      elemento.classList.add("show-feedback");

      setTimeout(() => {
        elemento.classList.remove("show-feedback");
        elemento.classList.add("hidden");
      }, duracion);
    };

    const ocultarFeedbacks = () => {
      [feedbackExito, feedbackError].forEach((el) => {
        if (el) {
          el.classList.remove("show-feedback");
          el.classList.add("hidden");
        }
      });
    };

    const mostrarError = (input: HTMLInputElement, mensaje: string) => {
      let errorSpan = input.nextElementSibling;

      if (input.name === "email" && !emailRegex.test(input.value.trim())) {
        mensaje = "Ingrese un email válido";
      }

      if (
        input.value.trim() === "" ||
        (input.name === "email" && !emailRegex.test(input.value.trim()))
      ) {
        input.classList.add("border-red-500/60", "bg-red-500/10", "text-red-400");
        input.classList.remove("border-secundario/10", "bg-base/20");
        if (!errorSpan || errorSpan.tagName !== "SPAN") {
          errorSpan = document.createElement("span");
          errorSpan.textContent = mensaje;
          errorSpan.classList.add("text-red-400", "text-xs", "mt-1", "font-secundario");
          input.parentNode?.appendChild(errorSpan);
        } else {
          errorSpan.textContent = mensaje;
        }
      } else {
        input.classList.remove(
          "border-red-500/60",
          "bg-red-500/10",
          "text-red-400"
        );
        input.classList.add("border-secundario/10", "bg-base/20");
        if (errorSpan && errorSpan.tagName === "SPAN") {
          errorSpan.remove();
        }
      }
      validarFormulario();
    };

    const validarFormulario = () => {
      let valido = true;
      inputs?.forEach((input) => {
        if (
          input.value.trim() === "" ||
          (input.name === "email" && !emailRegex.test(input.value.trim()))
        ) {
          valido = false;
        }
      });
      btnEnviar.disabled = !valido;
      btnEnviar?.classList.toggle("opacity-50", !valido);
      btnEnviar?.classList.toggle("cursor-not-allowed", !valido);
      obligatorio?.classList.remove("hidden");
    };

    inputs?.forEach((input) => {
      input.addEventListener("input", () =>
        mostrarError(input as HTMLInputElement, "Este campo es obligatorio")
      );
      input.addEventListener("blur", () =>
        mostrarError(input as HTMLInputElement, "Este campo es obligatorio")
      );
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      ocultarFeedbacks();
      const formData = Object.fromEntries(new FormData(form).entries());

      btnEnviar.disabled = true;
      btnEnviar?.classList.add("opacity-50", "cursor-not-allowed");

      try {
        const res = await fetch("/api/send-email", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(formData),
        });

        const data = await res.json();

        if (data.success) {
          form.reset();
          inputs?.forEach((input) => {
            input.classList.remove(
              "border-red-500/60",
              "bg-red-500/10",
              "text-red-400"
            );
            input.classList.add("border-secundario/10", "bg-base/20");
            const span = input.nextElementSibling;
            if (span && span.tagName === "SPAN") span.remove();
          });
          mostrarFeedback(feedbackExito, 4000);
        } else {
          if (feedbackErrorText) {
            feedbackErrorText.textContent =
              "Error: " + (data.error || "No se pudo enviar el mensaje");
          }
          mostrarFeedback(feedbackError, 5000);
        }
      } catch (err) {
        if (feedbackErrorText) {
          feedbackErrorText.textContent =
            "Error en la conexión con el servidor";
        }
        mostrarFeedback(feedbackError, 5000);
      } finally {
        btnEnviar.disabled = false;
        btnEnviar?.classList.remove("opacity-50", "cursor-not-allowed");
      }
    });
  });
</script>
